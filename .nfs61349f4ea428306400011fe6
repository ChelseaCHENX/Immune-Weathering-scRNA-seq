def normalize_patient_id(x):
    s = str(x).strip()

    # "31 (M)" → "31-M"
    s = re.sub(r'(\d+)\s*\(([^)]+)\)', r'\1-\2', s)

    # split number and optional suffix
    m = re.match(r'(\d+)(.*)', s)
    if not m:
        return s

    num, suffix = m.groups()
    return f"{int(num):02d}{suffix}"

